%% DFD: мобільний застосунок обліку особистих фінансів «FinTrack» (варіант 29).
%% Вигадана навчальна система. Позначення: ([...]) — зовнішня сутність,
%% [...] — процес, [(...)] — сховище даних, стрілка з підписом — потік даних.
flowchart TB
    E1([E1. Користувач]):::ext
    E2([E2. Open Banking API банку]):::ext

    subgraph TB1[Межа довіри 1: мобільний пристрій користувача]
        P1[P1. Мобільний застосунок]
        DS1[(DS1. Локальна БД SQLite)]
        DS2[(DS2. Сховище токенів і ключів)]
    end

    subgraph TB2[Межа довіри 2: хмарний бекенд]
        P2[P2. API-шлюз]
        P3[P3. Сервіс синхронізації]
        P4[P4. Сервіс імпорту транзакцій]
    end

    subgraph TB3[Межа довіри 3: зона зберігання даних]
        DS3[(DS3. Хмарна БД PostgreSQL)]
        DS4[(DS4. Журнал аудиту)]
        DS5[(DS5. Резервні копії)]
    end

    E1 -->|F1. транзакції, PIN, файл CSV| P1
    P1 -->|F2. баланси, звіти| E1
    P1 -->|F3. запис транзакцій| DS1
    DS1 -->|F4. читання транзакцій| P1
    P1 <-->|F5. токени, ключ БД| DS2
    P1 -->|F6. HTTPS: пакет синхронізації + JWT| P2
    P2 -->|F7. HTTPS: дельта змін| P1
    P2 -->|F8. автентифікований запит| P3
    P3 <-->|F9. SQL-запити| DS3
    E2 -->|F10. HTTPS webhook: нові транзакції| P4
    P4 -->|F11. OAuth2: запит виписки| E2
    P4 -->|F12. імпортовані транзакції| DS3
    P3 -->|F13. події аудиту| DS4
    P4 -->|F13. події аудиту| DS4
    DS3 -->|F14. щоденний бекап| DS5

    classDef ext fill:#eee,stroke:#333;
